[Desktop Entry]
Type=Application
Version=1.0
Name=vclock
GenericName=Clock
Comment=Transparent analog desktop clock
Exec=vclock
Icon=vclock
Terminal=false
StartupNotify=false
# No StartupWMClass on purpose.  It exists to tell the desktop which windows
# belong to this launcher, and vclock wants the opposite: its windows name
# themselves something no .desktop file claims, so that clicking the icon
# always runs the program -- which hands the request to the copy already
# running -- instead of being answered with a frameless clock nobody can see.
Categories=Utility;Clock;
Keywords=clock;time;analog;desktop;

# Right-clicking the icon in a dock or launcher offers these, which is the same
# menu the Windows build puts on its taskbar button and for the same reason: a
# clock has no frame and no taskbar entry of its own, so when one is hidden or
# buried the launcher icon is the only thing left pointing at the program.
# All three are forwarded to the copy already running.
Actions=Manage;Show;HideAll;

[Desktop Action Manage]
Name=Manage clocks
Exec=vclock --manage

[Desktop Action Show]
Name=Show my clocks
Exec=vclock --daemon

[Desktop Action HideAll]
Name=Hide all clocks
Exec=vclock --hide-all
